Options -Indexes

<FilesMatch "\.(php|phtml|phar|php[0-9]*)$">
    Require all denied
</FilesMatch>

# V4.2.1: los videos ya no se sirven directamente desde /uploads/videos.
# La reproduccion pasa por public/video_stream.php y la descarga por codigo.
<FilesMatch "\.(mp4|webm|mov|m4v)$">
    Require all denied
</FilesMatch>
